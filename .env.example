# Copy this file to .env and fill in the values. .env is ignored by git.

# The model the assistant uses. Any PydanticAI model name works.
# Default: a local model served by Ollama. No key needed.
ESHOP_MODEL=ollama:eshop-qwen
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Or Ollama's cloud (https://ollama.com/settings/keys; needs usage credits):
# ESHOP_MODEL=ollama:gemma4:31b
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_API_KEY=

# Or a hosted model. Groq (https://console.groq.com/keys):
# ESHOP_MODEL=groq:qwen/qwen3.8-27b
# GROQ_API_KEY=
# Groq's free plan allows 1,000 output tokens per minute, so cap the reply length:
# ESHOP_MAX_TOKENS=700

# Or Anthropic:
# ESHOP_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Optional: tracing with Langfuse (https://cloud.langfuse.com, free tier).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: only for a Neo4j that needs a login.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=
# NEO4J_PASSWORD=
