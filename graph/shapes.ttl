@prefix eshop: <http://example.org/eshop#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# SHACL shapes: the rules the data must follow.
#
# The ontology says what things mean and lets a reasoner add facts.
# The shapes check facts and report what is wrong or missing.
# OWL assumes missing data may exist somewhere (open world).
# SHACL treats missing data as missing (closed world), like a database constraint.
#
# Each shape has a target (which nodes to check) and properties (what to check).

<http://example.org/eshop/shapes>
    sh:declare [ sh:prefix "eshop" ; sh:namespace "http://example.org/eshop#"^^xsd:anyURI ] .


# ---------- products ----------

eshop:ProductShape a sh:NodeShape ;
    sh:targetClass eshop:Product ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A product needs exactly one name." ] ;
    sh:property [
        sh:path eshop:category ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A product needs exactly one category." ] ;
    sh:property [
        sh:path eshop:itemCondition ;
        sh:in ( "new" "refurbished" ) ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Condition must be 'new' or 'refurbished'." ] ;
    sh:property [
        sh:path eshop:unitPrice ;
        sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A product needs one price, a decimal of 0 or more." ] ;
    sh:property [
        sh:path eshop:stockQty ;
        sh:datatype xsd:integer ; sh:minInclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Stock must be one whole number of 0 or more." ] ;
    sh:property [
        sh:path eshop:releaseYear ;
        sh:datatype xsd:integer ; sh:minInclusive 1990 ; sh:maxInclusive 2030 ; sh:maxCount 1 ;
        sh:message "Release year must be between 1990 and 2030." ] ;
    sh:property [
        sh:path eshop:manufacturedBy ;
        sh:class eshop:Manufacturer ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A product needs exactly one manufacturer that exists in the graph." ] ;
    sh:property [
        sh:path eshop:hasPart ;
        sh:class eshop:Component ; sh:minCount 1 ;
        sh:message "A product needs at least one component, and every part must be a Component." ] ;
    # A business rule that needs a path through the graph, written in SPARQL.
    # The query returns the nodes that break the rule.
    sh:sparql [
        sh:prefixes <http://example.org/eshop/shapes> ;
        sh:message "A product sold as 'new' must not contain a RoHS-restricted material." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this eshop:itemCondition "new" ;
                      eshop:hasPart/eshop:containsMaterial ?value .
                ?value eshop:regulation ?regulation .
                FILTER (STRSTARTS(?regulation, "RoHS"))
            }""" ] .


# ---------- components and materials ----------

eshop:ComponentShape a sh:NodeShape ;
    sh:targetClass eshop:Component ;
    sh:property [
        sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A component needs exactly one name." ] ;
    sh:property [
        sh:path eshop:componentType ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A component needs exactly one type." ] ;
    sh:property [
        sh:path eshop:recyclable ; sh:datatype xsd:boolean ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Recyclable must be stated once, as true or false." ] ;
    sh:property [
        sh:path eshop:containsMaterial ; sh:class eshop:Material ; sh:minCount 1 ;
        sh:message "A component needs at least one material, and each must be a Material." ] .

eshop:MaterialShape a sh:NodeShape ;
    sh:targetClass eshop:Material ;
    sh:property [
        sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A material needs exactly one name." ] ;
    sh:property [
        sh:path eshop:casNumber ;
        sh:pattern "^[0-9]{2,7}-[0-9]{2}-[0-9]$" ; sh:maxCount 1 ;
        sh:message "A CAS number looks like 7439-92-1." ] ;
    # A warning, not a violation: mixtures such as glass have no single CAS number.
    sh:property [
        sh:path eshop:casNumber ; sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "This material has no CAS number." ] .

eshop:HazardousMaterialShape a sh:NodeShape ;
    sh:targetClass eshop:HazardousMaterial ;
    sh:property [
        sh:path eshop:regulation ; sh:datatype xsd:string ; sh:minCount 1 ;
        sh:message "A hazardous material must name the regulation that makes it hazardous." ] .

eshop:ManufacturerShape a sh:NodeShape ;
    sh:targetClass eshop:Manufacturer ;
    sh:property [
        sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A manufacturer needs exactly one name." ] ;
    sh:property [
        sh:path eshop:country ; sh:pattern "^[A-Z]{2}$" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Country must be a two-letter code such as DE." ] .


# ---------- the nodes that carry numbers ----------

eshop:PartUsageShape a sh:NodeShape ;
    sh:targetClass eshop:PartUsage ;
    sh:property [
        sh:path eshop:usedComponent ; sh:class eshop:Component ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A part usage points to exactly one component." ] ;
    sh:property [
        sh:path eshop:quantity ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Quantity must be one whole number of 1 or more." ] .

eshop:MaterialContentShape a sh:NodeShape ;
    sh:targetClass eshop:MaterialContent ;
    sh:property [
        sh:path eshop:material ; sh:class eshop:Material ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A material content points to exactly one material." ] ;
    sh:property [
        sh:path eshop:massGrams ; sh:datatype xsd:decimal ; sh:minExclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Mass must be one decimal above 0 grams." ] .


# ---------- sales ----------

eshop:CustomerShape a sh:NodeShape ;
    sh:targetClass eshop:Customer ;
    sh:property [
        sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A customer needs exactly one name." ] .

eshop:BillShape a sh:NodeShape ;
    sh:targetClass eshop:Bill ;
    sh:property [
        sh:path eshop:billedTo ; sh:class eshop:Customer ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bill belongs to exactly one customer." ] ;
    sh:property [
        sh:path eshop:billDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bill needs exactly one date." ] ;
    sh:property [
        sh:path eshop:hasLine ; sh:class eshop:BillLine ; sh:minCount 1 ;
        sh:message "A bill needs at least one line." ] .

eshop:BillLineShape a sh:NodeShape ;
    sh:targetClass eshop:BillLine ;
    sh:property [
        sh:path eshop:soldProduct ; sh:class eshop:Product ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bill line is for exactly one product." ] ;
    sh:property [
        sh:path eshop:quantity ; sh:datatype xsd:integer ; sh:minInclusive 1 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "Quantity must be one whole number of 1 or more." ] ;
    sh:property [
        sh:path eshop:unitPrice ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A bill line needs one price, a decimal of 0 or more." ] .
